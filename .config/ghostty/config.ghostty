# github.com/elithrar/dotfiles

theme = orng-dark
minimum-contrast = 1.1
font-size = 15
font-family = "TX-02"

window-padding-balance = true
window-padding-x = 5
window-padding-y = 0,10
window-width = 350
window-height = 472
font-thicken = true

# Extend cell bg colors into the padding area for a cleaner look
window-padding-color = extend

# Save and restore window state (position, tabs, splits, cwd) across restarts
window-save-state = always

window-colorspace = display-p3
scrollback-limit = 20000000
window-decoration = auto
macos-titlebar-style = native
macos-option-as-alt = true
macos-icon = chalkboard
clipboard-paste-protection = true
copy-on-select = true
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
# Keep Shift-drag available for terminal selection even when tmux/TUIs capture mouse input.
mouse-shift-capture = never
cursor-style-blink = false

# Enable all shell integration features, including SSH support and PATH setup.
shell-integration-features = true

# Notify after long-running commands finish while an integrated shell is unfocused.
# tmux consumes raw OSC 133 markers, so this applies to direct Ghostty shells.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

link-url = true
link-previews = osc8

auto-update = download
auto-update-channel = tip

# Quick terminal (global hotkey dropdown)
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.15

# Let TUIs that request extended keyboard protocols distinguish Shift+Enter.
keybind = shift+enter=unbind
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Smart copy: only intercept cmd+c when there's a selection
keybind = performable:cmd+c=copy_to_clipboard
keybind = cmd+shift+l=copy_url_to_clipboard

# Jump between shell prompts (requires shell integration)
keybind = shift+up=jump_to_prompt:-1
keybind = shift+down=jump_to_prompt:1
